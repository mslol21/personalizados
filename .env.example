# Variáveis de ambiente - Criativo Artes Personalizados
# Copie este arquivo para .env.local para customizar suas variáveis locais

# Senha para acesso ao Painel Administrativo (/admin/login)
ADMIN_PASSWORD=criativo2026

# Chave secreta para assinatura dos tokens JWT da sessão administrativa
JWT_SECRET=criativo-artes-secret-key-2026-secure

# URL pública do site (opcional, para geração de links absolutos no WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
