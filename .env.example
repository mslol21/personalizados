# Configure no servidor. Nunca publique valores reais.
# Senha administrativa com pelo menos 16 caracteres.
ADMIN_PASSWORD=
# Segredo aleatório com pelo menos 32 caracteres (openssl rand -hex 32).
JWT_SECRET=
# Origem exata do site, sem caminho. Em produção utilize HTTPS.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Persistência: file apenas em Node único com volume; supabase em Vercel.
# Na Vercel, supabase é o padrão. Localmente, file é o padrão.
# CATALOG_BACKEND=supabase
# URL do projeto Criativo Artes, apenas servidor.
SUPABASE_URL=https://cjfbbqvutsarubftkdlo.supabase.co
# Chave sb_secret_... de Settings > API Keys. Nunca usar NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Compatibilidade opcional: SUPABASE_SERVICE_ROLE_KEY (chave legada service_role).
# CATALOG_DATA_DIR=/var/lib/criativo-artes
